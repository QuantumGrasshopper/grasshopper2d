cff-version: 1.2.0
message: "If you use this software in published work, please cite this software release and the foundational paper listed under references."
title: "Grasshopper2D"
type: software
authors:
  - family-names: "Goulko"
    given-names: "Olga"
abstract: >-
  Grasshopper2D is a C++ implementation of simulated annealing for the
  planar Euclidean grasshopper problem on a square grid. It searches for
  unit-area lawn configurations that maximize the discretized grasshopper
  success probability for a fixed jump distance, with an optional
  nearest-neighbor interaction.
version: "1.0.0"
date-released: "2026-08-28"
doi: "10.5281/zenodo.22149974"
license: GPL-3.0-or-later
repository-code: "https://github.com/QuantumGrasshopper/grasshopper2d"
keywords:
  - grasshopper problem
  - simulated annealing
  - computational physics
  - statistical physics
  - optimization
  - fixed-distance interactions
references:
  - type: article
    authors:
      - family-names: "Goulko"
        given-names: "Olga"
      - family-names: "Kent"
        given-names: "Adrian"
    title: "The grasshopper problem"
    journal: "Proceedings of the Royal Society A: Mathematical, Physical and Engineering Sciences"
    volume: 473
    issue: 2207
    year: 2017
    doi: "10.1098/rspa.2017.0494"
    url: "https://arxiv.org/abs/1705.07621"
    scope: "Introduces the grasshopper problem and the numerical algorithm implemented by this software."
